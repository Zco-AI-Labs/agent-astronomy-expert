{
  "type": "container",
  "props": {
    "className": "flex flex-col gap-3.5 p-5 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl text-slate-100 max-w-md w-full"
  },
  "children": [
    {
      "type": "container",
      "props": {
        "className": "flex items-center justify-between border-b border-slate-800 pb-3"
      },
      "children": [
        {
          "type": "container",
          "props": {
            "className": "flex items-center gap-2.5"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "{{data.planet_emoji}}",
                "className": "text-2xl select-none"
              }
            },
            {
              "type": "container",
              "props": {
                "className": "flex flex-col"
              },
              "children": [
                {
                  "type": "text",
                  "props": {
                    "text": "{{data.planet_name}}",
                    "className": "text-lg font-bold text-slate-100 tracking-tight"
                  }
                },
                {
                  "type": "text",
                  "props": {
                    "text": "{{data.tagline}}",
                    "className": "text-xs text-slate-400 font-medium"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "colorProfile": "brand-2",
            "className": "text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "{{data.category}}"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "props": {
        "className": "grid grid-cols-2 gap-2"
      },
      "children": [
        {
          "type": "container",
          "props": {
            "className": "p-2.5 bg-slate-800/50 rounded-xl border border-slate-800/80 flex flex-col"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "Distance from Sun",
                "className": "text-[11px] text-slate-400 font-medium"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.distance_from_sun}}",
                "className": "text-xs font-semibold text-slate-200 mt-0.5"
              }
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "className": "p-2.5 bg-slate-800/50 rounded-xl border border-slate-800/80 flex flex-col"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "Diameter",
                "className": "text-[11px] text-slate-400 font-medium"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.diameter}}",
                "className": "text-xs font-semibold text-slate-200 mt-0.5"
              }
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "className": "p-2.5 bg-slate-800/50 rounded-xl border border-slate-800/80 flex flex-col"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "Day Length / Rotation",
                "className": "text-[11px] text-slate-400 font-medium"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.day_length}}",
                "className": "text-xs font-semibold text-slate-200 mt-0.5"
              }
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "className": "p-2.5 bg-slate-800/50 rounded-xl border border-slate-800/80 flex flex-col"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "Moons / Satellites",
                "className": "text-[11px] text-slate-400 font-medium"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.moons_count}}",
                "className": "text-xs font-semibold text-slate-200 mt-0.5"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "props": {
        "className": "p-3 bg-slate-800/30 rounded-xl border border-slate-800 flex flex-col gap-1.5"
      },
      "children": [
        {
          "type": "progress",
          "props": {
            "value": "{{data.scale_percentage}}",
            "label": "Relative Diameter Scale vs Earth / System",
            "size": "sm",
            "variant": "bar",
            "colorTheme": "blue"
          }
        },
        {
          "type": "text",
          "props": {
            "text": "Average Surface Temperature: {{data.avg_temperature}}",
            "className": "text-xs text-slate-300 font-medium mt-1"
          }
        }
      ]
    },
    {
      "type": "accordion",
      "props": {
        "title": "Atmosphere & Distinguishing Features",
        "defaultOpen": false,
        "size": "sm"
      },
      "children": [
        {
          "type": "container",
          "props": {
            "className": "flex flex-col gap-2 text-xs"
          },
          "children": [
            {
              "type": "text",
              "props": {
                "text": "Atmospheric Composition:",
                "className": "font-semibold text-slate-300"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.atmosphere}}",
                "className": "text-slate-400"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "Notable Geological Feature:",
                "className": "font-semibold text-slate-300 mt-1"
              }
            },
            {
              "type": "text",
              "props": {
                "text": "{{data.key_feature}}",
                "className": "text-slate-400 leading-relaxed"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "props": {
        "className": "p-3 bg-slate-800/40 rounded-xl border border-slate-800 flex flex-col gap-2"
      },
      "children": [
        {
          "type": "text",
          "props": {
            "text": "🔭 Observing Advisory:",
            "className": "text-xs font-semibold text-amber-300"
          }
        },
        {
          "type": "text",
          "props": {
            "text": "{{data.observing_tip}}",
            "className": "text-xs text-slate-300 leading-relaxed"
          }
        },
        {
          "type": "choice-picker",
          "props": {
            "name": "recommended_optics",
            "label": "Select Preferred Observation Aid",
            "layout": "horizontal",
            "size": "sm",
            "options": [
              "Naked Eye",
              "Binoculars",
              "Telescope"
            ]
          }
        },
        {
          "type": "toggle",
          "props": {
            "name": "sky_alert_enabled",
            "label": "Alert me when optimal in night sky",
            "variant": "switch",
            "colorProfile": "brand-1",
            "size": "sm"
          }
        }
      ]
    },
    {
      "type": "container",
      "props": {
        "className": "flex items-center gap-2 pt-1 border-t border-slate-800"
      },
      "children": [
        {
          "type": "button",
          "props": {
            "label": "Find in Night Sky",
            "actionUrl": "agent://{{agent_id}}/get_celestial_body_position?target={{data.planet_name}}",
            "colorProfile": "brand-1",
            "closeOnClick": false,
            "className": "flex-1 py-2 px-3 text-xs font-semibold rounded-lg shadow-sm transition-all"
          }
        },
        {
          "type": "button",
          "props": {
            "label": "Sky Forecast",
            "actionUrl": "agent://{{agent_id}}/get_stargazing_forecast",
            "colorProfile": "brand-2",
            "closeOnClick": false,
            "className": "flex-1 py-2 px-3 text-xs font-semibold rounded-lg shadow-sm transition-all"
          }
        },
        {
          "type": "button",
          "props": {
            "label": "Close",
            "actionUrl": "client://close_widget",
            "colorProfile": "canvas",
            "closeOnClick": true,
            "submittedLabel": "Dismissed",
            "className": "py-2 px-3 text-xs font-semibold rounded-lg transition-all"
          }
        }
      ]
    }
  ]
}